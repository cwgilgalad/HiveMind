<Project>

  <PropertyGroup Label="Language">
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup Label="Analysis">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- The XML documentation file lets IDE0005 run in the build. Missing comments are not errors. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Deterministic builds and SourceLink (spec section 8.3)">
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup Label="Restore">
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup Label="Version and product">
    <VersionPrefix>0.0.0</VersionPrefix>
    <VersionSuffix>dev</VersionSuffix>
    <Product>HiveMind</Product>
    <Copyright>Copyright (c) HiveMind contributors</Copyright>
  </PropertyGroup>

  <PropertyGroup Label="Product projects: everything under src/">
    <_HiveMindSrcDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'src'))</_HiveMindSrcDirectory>
    <IsProductProject Condition="$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)').StartsWith('$(_HiveMindSrcDirectory)', StringComparison.OrdinalIgnoreCase))">true</IsProductProject>
  </PropertyGroup>

  <!--
    Banned APIs (spec section 8.2): HM0001 flags banned native imports, and RS0030 flags the managed
    symbols in eng/BannedSymbols.txt. Both are errors in every product project. PrivateAssets keeps
    the analyzers out of the projects that reference a product project, so tests may still use them.
  -->
  <ItemGroup Label="Banned APIs" Condition="'$(IsProductProject)' == 'true' and '$(MSBuildProjectName)' != 'HiveMind.Analyzers'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/HiveMind.Analyzers/HiveMind.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)eng/BannedSymbols.txt" />
  </ItemGroup>

</Project>
