<Project>

  <PropertyGroup Label="Language">
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup Label="Analysis">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- The XML documentation file lets IDE0005 run in the build. Missing comments are not errors. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Deterministic builds and SourceLink (spec section 8.3)">
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup Label="Restore">
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup Label="Version and product">
    <VersionPrefix>0.0.0</VersionPrefix>
    <VersionSuffix>dev</VersionSuffix>
    <Product>HiveMind</Product>
    <Copyright>Copyright (c) HiveMind contributors</Copyright>
  </PropertyGroup>

  <PropertyGroup Label="Product projects: everything under src/">
    <_HiveMindSrcDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'src'))</_HiveMindSrcDirectory>
    <IsProductProject Condition="$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)').StartsWith('$(_HiveMindSrcDirectory)', StringComparison.OrdinalIgnoreCase))">true</IsProductProject>
  </PropertyGroup>

</Project>
